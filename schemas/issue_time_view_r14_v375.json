{
  "schema_version": "KDEN_V375_ISSUE_TIME_VIEW_SCHEMA_V1",
  "scope_id": "KDEN_V375_R14_V1",
  "tables": {
    "temperature_trajectory": {
      "primary_key": [
        "target_day",
        "issue_time_utc",
        "product",
        "cycle_init_utc",
        "valid_time_utc"
      ],
      "columns": [
        "target_day",
        "issue_time_utc",
        "issue_time_local",
        "product",
        "baseline_id",
        "cycle_init_utc",
        "cycle_init_local",
        "emulated_complete_time_utc",
        "valid_time_utc",
        "valid_time_local",
        "forecast_lead_min",
        "bi_value",
        "nn_value",
        "coverage_flag",
        "missing_reason"
      ]
    },
    "cycle_revision": {
      "join_support": [
        "field_registry_id",
        "valid_time_utc"
      ],
      "columns": [
        "target_day",
        "issue_time_utc",
        "product",
        "field_registry_id",
        "valid_time_utc",
        "current_cycle_init_utc",
        "previous_cycle_init_utc",
        "value_column",
        "current_value",
        "previous_value",
        "revision_value",
        "current_coverage_flag",
        "previous_coverage_flag"
      ]
    },
    "cross_product_temperature": {
      "join_support": [
        "target_day",
        "issue_time_utc",
        "valid_time_utc"
      ],
      "columns": [
        "target_day",
        "issue_time_utc",
        "alignment_contract",
        "valid_time_utc",
        "hourly_cycle_init_utc",
        "q05_cycle_init_utc",
        "h16_bi_value",
        "q05_bi_value",
        "q05_minus_h16",
        "hourly_coverage_flag",
        "q05_coverage_flag"
      ]
    }
  },
  "rules": {
    "availability": "selected cycle emulated_complete_time_utc must be less than or equal to issue_time_utc",
    "trajectory": "one native same-cycle path; never concatenate cycles",
    "revision": "compare two cycles only on identical field and valid-time support",
    "cross_product": "caller must declare separate_experts or same_cycle",
    "missingness": "retain explicit missing rows and produce null derived values",
    "truth_isolation": "no observed Tmax, MADIS, market, or outcome columns"
  }
}
