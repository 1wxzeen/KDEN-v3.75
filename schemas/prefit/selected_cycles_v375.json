{
  "$id": "KDEN_V375_SELECTED_CYCLES_SCHEMA_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Logical row contract for one independently selected R14 product cycle at an issue state.",
  "properties": {
    "issue_state_id": {"pattern": "^ISSUE_[0-9a-f]{64}$", "type": "string"},
    "target_date": {"format": "date", "type": "string"},
    "issue_time_utc": {"type": "string"},
    "product": {"enum": ["wrfsfcf", "wrfsubhf"]},
    "selection_status": {"enum": ["SELECTED", "MISSING_NO_LEGAL_CYCLE", "MISSING_ARCHIVE_BUNDLE"]},
    "cycle_init_utc": {"type": ["string", "null"]},
    "cycle_init_local": {"type": ["string", "null"]},
    "emulated_complete_time_utc": {"type": ["string", "null"]},
    "cycle_age_minutes": {"minimum": 0, "type": ["integer", "null"]},
    "availability_age_minutes": {"minimum": 0, "type": ["integer", "null"]},
    "previous_cycle_init_utc": {"type": ["string", "null"]},
    "previous_cycle_init_local": {"type": ["string", "null"]},
    "previous_emulated_complete_time_utc": {"type": ["string", "null"]},
    "previous_cycle_age_minutes": {"minimum": 0, "type": ["integer", "null"]},
    "previous_availability_age_minutes": {"minimum": 0, "type": ["integer", "null"]},
    "availability_policy_id": {"const": "KDEN_HIST_COMPLETE_L105_V1"},
    "availability_basis": {"type": "string"},
    "source_schedule_id": {"type": "string"},
    "source_schedule_row_id": {"type": ["string", "null"]},
    "previous_source_schedule_row_id": {"type": ["string", "null"]},
    "retained_valid_start_utc": {"type": ["string", "null"]},
    "retained_valid_end_utc": {"type": ["string", "null"]},
    "previous_retained_valid_start_utc": {"type": ["string", "null"]},
    "previous_retained_valid_end_utc": {"type": ["string", "null"]},
    "trajectory_bundle_id": {"type": ["string", "null"]},
    "trajectory_bundle_path": {"type": ["string", "null"]},
    "trajectory_bundle_present": {"type": "boolean"},
    "previous_trajectory_bundle_id": {"type": ["string", "null"]},
    "previous_trajectory_bundle_path": {"type": ["string", "null"]},
    "previous_trajectory_bundle_present": {"type": "boolean"},
    "selection_missing_reason": {"type": ["string", "null"]}
  },
  "required": [
    "issue_state_id", "target_date", "issue_time_utc", "product",
    "selection_status", "cycle_init_utc", "cycle_init_local",
    "emulated_complete_time_utc", "cycle_age_minutes",
    "availability_age_minutes", "previous_cycle_init_utc",
    "previous_cycle_init_local", "previous_emulated_complete_time_utc",
    "previous_cycle_age_minutes", "previous_availability_age_minutes",
    "availability_policy_id", "availability_basis", "source_schedule_id",
    "source_schedule_row_id", "previous_source_schedule_row_id",
    "retained_valid_start_utc", "retained_valid_end_utc",
    "previous_retained_valid_start_utc", "previous_retained_valid_end_utc",
    "trajectory_bundle_id", "trajectory_bundle_path",
    "trajectory_bundle_present", "previous_trajectory_bundle_id",
    "previous_trajectory_bundle_path", "previous_trajectory_bundle_present",
    "selection_missing_reason"
  ],
  "type": "object"
}
