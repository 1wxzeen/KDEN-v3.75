{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "KDEN_V375_STEP_PASS_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "step_id", "status", "completed_at_utc", "run_id", "predecessor_hashes", "artifact_hashes", "gate_evidence", "record_sha256"],
  "properties": {
    "schema_version": {"const": "KDEN_V375_STEP_PASS_V1"},
