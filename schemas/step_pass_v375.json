    "status": {"const": "PASS"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string"},
    "predecessor_hashes": {"type": "object"},
    "artifact_hashes": {"type": "object"},
    "gate_evidence": {"type": "object"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

