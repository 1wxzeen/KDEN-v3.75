      "absolute_error_thresholds_f": [
        3,
        5,
        10
      ],
      "directions": [
        "warm",
        "cold"
      ],
      "point": "PMF_median primary; PMF_mean secondary",
      "quantiles": "weighted inverse empirical CDF using day-normalized row weights",
      "strictness": ">="
