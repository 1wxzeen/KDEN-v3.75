    "point_metrics": {
      "bias": "PMF_mean-y",
      "continuous_named_comparators": "also MAE/RMSE/bias for raw center, PMF_mean, PMF_median, and GAM mu separately; no metric mixing",
      "mae": "abs(PMF_median-y)",
      "modal_integer_hit": "PMF_mode==y",
      "rmse": "sqrt(mean((PMF_mean-y)^2))",
      "rounded_point_hit": "round(raw_center for B0; mu for GAM; PMF_mean for AnEn)==y",
      "within_one": "abs(PMF_mode-y)<=1",
      "within_two": "abs(PMF_mode-y)<=2"
    },
    "required_figures": [
      "overall_paired_scorecard",
      "fold_issue_heatmaps",
      "exact_and_band_reliability",
      "precision_coverage",
      "selective_loss_coverage",
      "interval_coverage_width",
      "PIT",
      "signed_and_tail_errors",
      "analog_support_vs_error",
      "GAM_effects_supported_ranges",
      "intraday_case_paths"
    ],
    "scale_near_bounds": "sigma<=0.26 OR sigma>=19.9",
