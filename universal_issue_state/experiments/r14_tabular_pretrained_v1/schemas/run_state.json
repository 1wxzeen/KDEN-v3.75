{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "pid", "completed_inputs", "total_inputs", "phase", "current_input", "active_seconds", "updated_at_utc", "message"],
  "properties": {
    "schema_version": {"const": "R14_TABULAR_T01_RUN_V1"}, "run_id": {"type": "string", "pattern": "^kden-r14-t01-[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,31}$"},
    "status": {"enum": ["RUNNING", "PAUSED", "FAILED", "PASS"]}, "pid": {"type": ["integer", "null"]},
    "completed_inputs": {"type": "integer", "minimum": 0}, "total_inputs": {"type": "integer", "minimum": 0},
    "phase": {"type": "string"}, "current_input": {"type": ["string", "null"]}, "active_seconds": {"type": "number", "minimum": 0},
    "updated_at_utc": {"type": "string"}, "message": {"type": ["string", "null"]}
  }
}
