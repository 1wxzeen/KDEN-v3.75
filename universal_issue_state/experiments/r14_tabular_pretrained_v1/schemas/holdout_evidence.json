    "archive_bundles": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["pil", "year", "paths", "present"]}},
    "missing_audit_dates": {"type": "array", "items": {"type": "string"}}, "content_audit_performed": {"type": "boolean", "const": false},
    "holdout_value_pages_read": {"const": 0}, "interpretation": {"type": "string"}
  }
}
