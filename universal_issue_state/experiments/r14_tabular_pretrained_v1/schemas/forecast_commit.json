{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "description": "Interface reserved for T03 atomic forecast publication; T01 does not emit forecasts.",
  "required": ["schema_version", "status", "artifact_path", "artifact_sha256", "target_dates", "recipe_sha256", "model_id", "run_id", "record_sha256"],
  "properties": {
    "schema_version": {"const": "R14_TABULAR_FORECAST_COMMIT_V1"}, "status": {"const": "COMMITTED"},
    "artifact_path": {"type": "string", "pattern": "^runs/.*\\.parquet$"}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_dates": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "recipe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_id": {"type": "string"}, "run_id": {"type": "string"}, "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
